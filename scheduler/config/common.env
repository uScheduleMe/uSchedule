# ===== General =====
SERVICE_NAME=scheduler
NODE_ENV=production
PORT=3001
RUN_SRC=false
ENABLE_WATCHER=false
DEBUG=false
ENABLE_DEBUG_ENDPOINTS=false
ENABLE_CI_ENDPOINTS=false
# ===== AWS =====
# These 2 need to remain empty to be inherited from the environment
AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
# ===== Logging =====
LOG_CONSOLE_LEVEL=info
LOG_EXPORT_LEVEL=debug
LOG_DIR=/var/log/uschedule
# LOG_MAX_FILES=
LOG_PRIVATE=false
LOG_ENABLE_TRANSPORTS=file
# ===== Schedule Generator =====
NUM_WORKERS=4
GENERATOR_LIMIT=2000
GENERATOR_V2_LIMIT=1000
# ===== Tokens =====
ISSUER=uschedule.me
ACCESS_TOKEN_LIFESPAN=1h
REFRESH_TOKEN_LIFESPAN=14d
USE_SECURE_TOKEN_COOKIES=true
TOKEN_COOKIE_SCOPE=/api
REFRESH_COOKIE_SCOPE=/api/v3/auth
# ===== Auth =====
AUTH_BASE_HOST=
AUTH_BASE_PATH=/api/v3
# ===== Database =====
DATABASE_PORT=5432
