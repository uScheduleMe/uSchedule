# ===== General =====
ENV=dev
NODE_ENV=development
RUN_SRC=true
ENABLE_WATCHER=true
DEBUG=true
ENABLE_DEBUG_ENDPOINTS=true
ENABLE_CI_ENDPOINTS=true
EXTRA_TERMS=2020-winter
# ===== Logging =====
LOG_CONSOLE_LEVEL=debug
LOG_EXPORT_LEVEL=debug
LOG_MAX_FILES=14d
LOG_PRIVATE=true
# ===== Schedule Generator =====
NUM_WORKERS=0
GENERATOR_LIMIT=1500
GENERATOR_V2_LIMIT=1500
# ===== Tokens =====
USE_SECURE_TOKEN_COOKIES=false
# ===== Auth =====
AUTH_BASE_HOST=http://localhost
# ===== Database =====
DATABASE_HOST=pg-db
