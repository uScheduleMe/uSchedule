{
  "name": "uschedule_scheduler",
  "main": "dist/main.js",
  "version": "0.0.0",
  "description": "Scheduler service for uschedule.me",
  "license": "UNLICENSED",
  "scripts": {
    "build": "rimraf dist && eslint --fix && tsc -p tsconfig.exclude.json",
    "format": "prettier --write .",
    "type": "tsc --noEmit -p tsconfig.exclude.json",
    "lint": "eslint '*/**/*.{js,ts}' --cache --report-unused-disable-directives --fix",
    "lint-f": "eslint '*/**/*.{js,ts}' --report-unused-disable-directives --fix",
    "start": "node -r ./tsconfig-paths.js .",
    "start:watch": "nodemon dist/main.js",
    "start:src": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:src:watch": "nodemon src/main.ts",
    "test": "nyc mocha",
    "test:ci": "nyc mocha --config .mocharc.ci.yaml",
    "test:watch": "mocha --config .mocharc.watch.yaml",
    "api-doc": "ts-node -r tsconfig-paths/register src/scripts/open_api.ts"
  },
  "lint-staged": {
    "*.{js,ts,json,yaml,yml,md}": "prettier --write",
    "*.{js,ts}": "eslint --cache --report-unused-disable-directives --fix"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.354.0",
    "cartesian-product-generator": "^1.1.1",
    "cookie-parser": "^1.4.6",
    "drizzle-orm": "^0.29.1",
    "express": "^4.18.2",
    "express-zod-api": "^15.0.0",
    "jose": "^5.1.3",
    "moment": "^2.29.4",
    "node-fetch": "^2.6.9",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-microsoft": "^1.0.0",
    "postgres": "^3.3.5",
    "response-time": "^2.3.2",
    "tsconfig-paths": "^4.1.2",
    "winston": "^3.8.2",
    "winston-daily-rotate-file": "^4.7.1",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "^0.5.1",
    "@types/chai": "^4.3.4",
    "@types/chai-as-promised": "^7.1.5",
    "@types/cookie-parser": "^1.4.3",
    "@types/express": "^4.17.19",
    "@types/http-errors": "^2.0.2",
    "@types/mocha": "^10.0.1",
    "@types/node": "^18.15.3",
    "@types/node-fetch": "^2.6.2",
    "@types/passport": "^1.0.12",
    "@types/passport-facebook": "^3.0.1",
    "@types/passport-google-oauth20": "^2.0.11",
    "@types/passport-microsoft": "^1.0.0",
    "@types/response-time": "^2.3.5",
    "@types/rewire": "^2.5.28",
    "@types/sinon-chai": "^3.2.10",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "chai": "^4.3.7",
    "chai-as-promised": "^7.1.1",
    "drizzle-kit": "^0.20.6",
    "eslint": "^8.36.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-chai-expect": "^3.0.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-jsdoc": "^46.4.6",
    "eslint-plugin-mocha": "^10.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-typescript-enum": "^2.1.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "lint-staged": "^15.0.1",
    "mocha": "^10.2.0",
    "nodemon": "^3.0.1",
    "nyc": "^15.1.0",
    "prettier": "^3.0.3",
    "rewire": "^7.0.0",
    "rimraf": "^5.0.0",
    "sinon": "^17.0.1",
    "sinon-chai": "^3.7.0",
    "ts-node": "^10.9.1",
    "ts-sinon": "^2.0.2",
    "typescript": "~5.3.2"
  },
  "nyc": {
    "all": true,
    "check-coverage": false,
    "lines": 95,
    "statements": 95,
    "functions": 95,
    "branches": 95,
    "extension": [
      ".js",
      ".ts"
    ],
    "include": [
      "src/**/*"
    ],
    "exclude": [
      "**/*.spec.{js,ts}",
      "**/__test__"
    ]
  }
}
