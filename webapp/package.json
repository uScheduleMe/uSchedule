{
  "name": "uschedule_reactapp",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "react-app-rewired build",
    "cy:ci": "(yarn run cy:install && yarn run cy:delete:reports && cypress run --browser chrome --config-file cypress.config.ci.ts && yarn run cy:combine:reports) || (yarn run cy:combine:reports && exit 2)",
    "cy:combine:reports": "mochawesome-merge \"cypress/reports/mochawesome*.json\" > cypress/reports/merged-report.json",
    "cy:delete:reports": "rimraf cypress/reports/*",
    "cy:install": "cypress install",
    "cy:open": "cypress open",
    "cy:run": "cypress run --browser chrome",
    "eject": "react-scripts eject",
    "format": "prettier --write .",
    "jest": "react-app-rewired test",
    "lint": "eslint '*/**/*.{js,ts,tsx}' --cache --report-unused-disable-directives --fix",
    "lint-f": "eslint '*/**/*.{js,ts,tsx}' --report-unused-disable-directives --fix",
    "lint:tx": "eslint --fix --ext .json --config .eslintrc.i18n-json.js --no-eslintrc --format node_modules/eslint-plugin-i18n-json/formatter.js src/translations/",
    "snap": "react-app-rewired test --updateSnapshot --coverage --watchAll=false",
    "start": "react-app-rewired start",
    "test": "react-app-rewired test --coverage --watchAll=false --colors",
    "test:ci": "react-app-rewired test --ci --coverage --watchAll=false --colors",
    "test:watch": "react-app-rewired test --watch --coverage=false",
    "type": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.1.2",
    "@fortawesome/free-brands-svg-icons": "^6.1.2",
    "@fortawesome/free-regular-svg-icons": "^6.1.2",
    "@fortawesome/free-solid-svg-icons": "^6.1.2",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@material-ui/core": "^4.12.4",
    "axios": "^1.5.1",
    "axios-auth-refresh": "^3.3.3",
    "cartesian-product-generator": "^1.1.1",
    "comlink": "^4.4.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "file-saver": "^2.0.5",
    "i18next": "^23.5.1",
    "i18next-browser-languagedetector": "^7.0.0",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.37",
    "react": "^16.14.0",
    "react-app-alias": "^2.2.2",
    "react-app-rewired": "^2.2.1",
    "react-awesome-gravatar": "^2.0.3",
    "react-bootstrap": "^1.6.5",
    "react-bootstrap-typeahead": "^5.2.2",
    "react-dom": "^16.14.0",
    "react-ga4": "^2.1.0",
    "react-google-recaptcha": "^3.1.0",
    "react-helmet": "^6.1.0",
    "react-i18next": "^13.3.0",
    "react-moment": "^1.1.2",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "react-toastify": "^9.0.8",
    "zod": "^3.18.0"
  },
  "devDependencies": {
    "@babel/core": "^7.21.8",
    "@babel/helper-define-map": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.0",
    "@types/enzyme": "^3.10.13",
    "@types/enzyme-adapter-react-16": "^1.0.6",
    "@types/file-saver": "^2.0.5",
    "@types/jest": "^29.5.1",
    "@types/node": "^18.14.6",
    "@types/react": "16.14.39",
    "@types/react-bootstrap": "^1.0.1",
    "@types/react-bootstrap-typeahead": "^5.1.8",
    "@types/react-dom": "^16.9.16",
    "@types/react-google-recaptcha": "^2.1.5",
    "@types/react-helmet": "^6.1.5",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "babel-jest": "^29.5.0",
    "customize-cra": "^1.0.0",
    "customize-cra-react-refresh": "^1.1.0",
    "cypress": "^13.3.1",
    "cypress-multi-reporters": "^1.6.1",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.6",
    "enzyme-to-json": "^3.6.2",
    "eslint": "^8.22.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-i18n-json": "^4.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.31.0",
    "jest": "^29.5.0",
    "jest-enzyme": "^7.1.2",
    "jest-junit": "^16.0.0",
    "lint-staged": "^15.0.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.2.1",
    "mochawesome-report-generator": "^6.2.0",
    "prettier": "^3.0.3",
    "prop-types": "^15.8.1",
    "rimraf": "^5.0.5",
    "typescript": "~5.3.2",
    "utility-types": "^3.10.0"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "@types/react": "16.14.26",
    "@types/react-dom": "16.9.16"
  },
  "jest": {
    "moduleNameMapper": {
      "axios": "axios/dist/node/axios.cjs",
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@contexts/(.*)$": "<rootDir>/src/contexts/$1",
      "^@hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "^@icons/(.*)$": "<rootDir>/src/icons/$1",
      "^@models/(.*)$": "<rootDir>/src/models/$1",
      "^@modules/(.*)$": "<rootDir>/src/modules/$1",
      "^@services/(.*)$": "<rootDir>/src/services/$1",
      "^@stores/(.*)$": "<rootDir>/src/stores/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1",
      "^@src/(.*)$": "<rootDir>/src/$1"
    },
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      }
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/services/LocalScheduler/createWorker.ts"
    ],
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ],
    "reporters": [
      "default",
      "jest-junit"
    ]
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "jest-junit.xml",
    "ancestorSeparator": " › ",
    "uniqueOutputName": "false",
    "suiteNameTemplate": "{filepath}",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}"
  },
  "lint-staged": {
    "*.{json,html,css,scss,md}": "prettier --write",
    "*.{js,ts,tsx}": "eslint --fix",
    "src/translations/*.json": "eslint --config .eslintrc.i18n-json.js --no-eslintrc --format node_modules/eslint-plugin-i18n-json/formatter.js --fix"
  }
}
